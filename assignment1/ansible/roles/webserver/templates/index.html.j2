<!doctype html>
<html>
<head>
    <title>{{ site_title }}</title>
</head>
<body>
    <h1>{{ site_title }}</h1>

    <p>Environment: {{ deployment_environment }}</p>

    <p>Version: {{ app_version }}</p>

    <p>Build: {{ build_tag }}</p>

    <p>Host name: {{ ansible_facts['hostname'] }}</p>

    <p>
        Private IP:
        {{ ansible_facts['default_ipv4']['address'] }}
    </p>

    <p>
        Distribution:
        {{ ansible_facts['distribution'] }}
        {{ ansible_facts['distribution_version'] }}
    </p>

    <p>Served by: {{ app_user }} on port {{ app_port }}</p>
    <h2>Deployment Information</h2>

    <p>Release: Multi-environment deployment</p>

    <p>Infrastructure managed by Terraform</p>

    <p>Application configured by Ansible over AWS SSM</p>

    <p>Deployment automated by GitHub Actions</p>
</body>
</html>

